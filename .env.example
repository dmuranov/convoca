# Copy to .env (chmod 600) and fill in. server.js loads it via dotenv.
ANTHROPIC_API_KEY=
PORT=3003
NODE_ENV=production
BASE_URL=https://plazoabierto.es
SESSION_SECRET=
# First-boot operator account (created only if no operator exists yet)
OPERATOR_EMAIL=
OPERATOR_PASSWORD=
# Contact form -> operator notification. No MX record and no mail transport in this
# project: notifyOperator() always writes an alert the operator console shows, and if a
# webhook is set it also pushes. Both of these need no domain and cost nothing:
#   ntfy.sh:  https://ntfy.sh/<invent-a-secret-topic>          FORMAT=text
#   Telegram: https://api.telegram.org/bot<token>/sendMessage?chat_id=<id>   FORMAT=telegram
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_FORMAT=text

# WhatsApp outbound (Infobip) - notifying alcaldes about matched grants
# (src/whatsapp.js, used from POST /api/op/grants/:id/notify). All three
# required for sends to actually go out; missing any one keeps it inert
# (falls back to the manual copy-paste draft, same as before this existed).
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_FROM=
# Name of the approved WhatsApp template, once Meta/Infobip approves it.
# Expects exactly 3 body placeholders in order: {{1}} plain_title,
# {{2}} plain_explainer.para_que, {{3}} plain_checklist (papers needed).
INFOBIP_WHATSAPP_TEMPLATE_GRANT=

# WhatsApp inbound (Infobip) - alcalde replies land here and mark the
# matching notification's response (src/routes/webhooks.js). Configure
# Infobip's inbound webhook to POST to:
#   https://plazoabierto.es/webhooks/whatsapp/<this value>
WHATSAPP_WEBHOOK_SECRET=

# Optional tuning
POLL_LOOKBACK_DAYS=7
CHAT_DAILY_CAP=10
# CONVOCA_MODEL=claude-opus-5
CONTACT_DAILY_CAP=3
CONTACT_RETENTION_DAYS=365
